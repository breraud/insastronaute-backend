{
  "realm": "insastronaute",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN"
      },
      {
        "name": "STUDENT"
      },
      {
        "name": "STUDENT_LIMITED"
      },
      {
        "name": "MODERATOR"
      },
      {
        "name": "RESPOS_EVENT"
      },
      {
        "name": "SOUS_RESPO_DEPART"
      },
      {
        "name": "RESPO_DEPART"
      },
      {
        "name": "SOUS_RESPO_DEFIS"
      },
      {
        "name": "SOUS_RESPO_CARTES"
      },
      {
        "name": "SOUS_RESPO_TOURNOIS"
      },
      {
        "name": "SOUS_RESPO_GOODIES"
      },
      {
        "name": "RESPO_CARTES"
      },
      {
        "name": "RESPO_TOURNOIS"
      },
      {
        "name": "RESPOS_DEFIS"
      },
      {
        "name": "RESPO_GOODIES"
      },
      {
        "name": "SOUS_RESPO_EVENT"
      }
    ]
  },
  "clients": [
    {
      "clientId": "inte-backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-client-secret",
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:3457/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3457/*##http://localhost:5173/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "kc-admin-api"
      ]
    }
  ],
  "users": [
    {
      "username": "developer",
      "enabled": true,
      "email": "developer@example.test",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Developer",
      "credentials": [
        {
          "type": "password",
          "value": "local-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "STUDENT"
      ]
    },
    {
      "username": "service-account-inte-backend",
      "enabled": true,
      "serviceAccountClientId": "inte-backend",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "query-groups",
          "view-realm",
          "manage-users"
        ]
      }
    }
  ]
}
