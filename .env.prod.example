APP_DB_NAME=insastronaute
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_PUBLIC_ENDPOINT=https://s3.example.com
S3_PUBLIC_BUCKET=insastronaute-public
S3_BUCKET_CORS_ENABLED=true
S3_PUBLIC_BUCKET_RUN_ACL_HARDENING_ENABLED=true
S3_FAIL_ON_POLICY_ERROR=true
S3_FAIL_ON_CORS_ERROR=true
S3_FAIL_ON_ACL_ERROR=true
APP_PROOFS_UPLOAD_TIMEOUT_MINUTES=15
APP_ARTICLES_MEDIA_CLEANUP_ENABLED=true
APP_ARTICLES_MEDIA_CLEANUP_CRON='0 0 3 * * *'
APP_AUTO_CHALLENGES_SCHEDULER_ENABLED=true
APP_AUTO_CHALLENGES_SCHEDULER_CRON='0 0 * * * *'
APP_AUTO_CHALLENGES_SCHEDULER_BATCH_SIZE=250
APP_AUTO_CHALLENGES_SCHEDULER_LOCK_DURATION=PT55M
APP_GAME_CONFIG_OBJECT_PREFIX=GameData/current/dev/
APP_GAME_CONFIG_RELEASES_OBJECT_PREFIX=GameData/versions/
# Reecrit la run de son appelant (pv, deck, reliques, ennemis) et paie le noeud
# comme une vraie victoire. Reserve au staff par SecurityConfig, et a laisser
# ferme en production : un gabarit de production qui l'ouvre est un piege.
APP_STS_DEBUG_COMBAT_ENABLED=false
# Le mode multijoueur. A false, aucune route PvP n'est deployee -- appariement, duels et
# socket de combat disparaissent -- et le jeu cache son bouton parce que
# /api/sts/pvp/availability, qui repond toujours, lui dit que c'est ferme. Un redemarrage
# du conteneur est necessaire : la condition est lue au demarrage.
APP_STS_PVP_ENABLED=true

KEYCLOAK_CLIENT_ID=inte-backend
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ISSUER_URI=https://auth.example.com/realms/inte
KEYCLOAK_DEPARTMENT_GROUP_SYNC_ENABLED=true
KEYCLOAK_DEPARTMENT_GROUP_SYNC_CONNECT_TIMEOUT=2s
KEYCLOAK_DEPARTMENT_GROUP_SYNC_READ_TIMEOUT=5s

FRONTEND_BASE_URL=https://frontend.example.com
QR_LINK_PUBLIC_URL=https://api.example.com/q
QR_LINK_SCAN_LANDING_URL=https://frontend.example.com/scan
DOMAIN=example.com
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=3457
SERVER_SERVLET_SESSION_TIMEOUT=8h
SERVER_SERVLET_SESSION_COOKIE_MAX_AGE=8h
SERVER_SERVLET_SESSION_COOKIE_SAME_SITE=none
SPRING_SESSION_REDIS_NAMESPACE=insastronaute:sessions

# Push web. Genere une paire de cles une seule fois -- la changer invalide d'un coup
# tous les abonnements existants. La cle publique est servie au navigateur, la privee
# ne quitte jamais le serveur.
APP_PUSH_ENABLED=false
APP_PUSH_SUBJECT=mailto:contact@example.com
APP_PUSH_VAPID_PUBLIC_KEY=
APP_PUSH_VAPID_PRIVATE_KEY=

# Unique signing key for admission tokens. Generate with: openssl rand -hex 32
# Replace this placeholder before deployment; keep the value private.
APP_AUTH_GATE_SECRET=change-me
