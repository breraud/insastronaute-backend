# Copy to .env.prod. Replace every change-me value with a separate strong secret.
APP_DB_NAME=insastronaute
POSTGRES_USER=insastronaute
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
BACKEND_PORT=3457

KEYCLOAK_CLIENT_ID=inte-backend
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ISSUER_URI=https://auth.example.com/realms/insastronaute
APP_SECURITY_FRONTEND_BASE_URL=https://app.example.com
DOMAIN=example.com
APP_SECURITY_ALLOWED_SUBDOMAINS=app,admin,s3
APP_AUTH_GATE_SECRET=change-me

# Internal server endpoint and public browser endpoint may differ.
S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
S3_BUCKET=insastronaute-proofs
S3_PUBLIC_BUCKET=insastronaute-public
S3_FAIL_ON_POLICY_ERROR=true
S3_FAIL_ON_CORS_ERROR=true
S3_FAIL_ON_ACL_ERROR=true

QR_LINK_PUBLIC_URL=https://api.example.com/q
QR_LINK_SCAN_LANDING_URL=https://app.example.com/scan
SPRING_SESSION_REDIS_NAMESPACE=insastronaute:sessions
APP_STS_PVP_ENABLED=false
APP_PUSH_ENABLED=false
